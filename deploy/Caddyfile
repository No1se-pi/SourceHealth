sourcehealth.tech {
    encode gzip

    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        root * /opt/sourcehealth/frontend/dist
        try_files {path} /index.html
        file_server
    }
}

http://sourcehealth.tech {
    redir https://sourcehealth.tech{uri} permanent
}
