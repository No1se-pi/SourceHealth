[Unit]
Description=SourceHealth scheduler one-shot
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/sourcehealth
ExecStart=/usr/bin/docker compose --env-file /etc/sourcehealth/sourcehealth.env -f /opt/sourcehealth/compose.yaml -f /etc/sourcehealth/compose.production.yaml run --rm scheduler
