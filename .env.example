# Только локальные development credentials. Не использовать на публичном стенде.
POSTGRES_PORT=15432
DATABASE_URL=postgresql+psycopg://sourcehealth:sourcehealth@127.0.0.1:15432/sourcehealth
REDIS_URL=redis://127.0.0.1:6379/0
SOURCECRAFT_API_BASE_URL=https://api.sourcecraft.tech
# SOURCECRAFT_PAT= задаётся только в локальном .env для service/dev сценариев
YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://localhost/api/v1/auth/yandex/callback
PUBLIC_ORIGIN=https://localhost
# SESSION_SECRET= случайная строка минимум 32 символа
COOKIE_SECURE=true
ANALYSIS_TIMEOUT=600
ANALYSIS_PROFILE=platform-v1
PLATFORM_CACHE_TTL=300
CODE_CACHE_TTL=604800
RESULT_CACHE_TTL=300
REFRESH_INTERVAL=86400
