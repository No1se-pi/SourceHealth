# Только локальные development credentials. Не использовать на публичном стенде.
POSTGRES_PORT=15432
DATABASE_URL=postgresql+psycopg://sourcehealth:sourcehealth@127.0.0.1:15432/sourcehealth
REDIS_URL=redis://127.0.0.1:6379/0
SOURCECRAFT_API_BASE_URL=https://api.sourcecraft.tech
# SOURCECRAFT_PAT= задаётся только в локальном .env для service/dev сценариев
YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://127.0.0.1:5173/api/v1/auth/yandex/callback
PUBLIC_ORIGIN=http://127.0.0.1:5173
# SESSION_SECRET= случайная строка минимум 32 символа
COOKIE_SECURE=false
# Public deployment: HTTPS callback/origin, COOKIE_SECURE=true, random SESSION_SECRET >=32 chars.
ANALYSIS_TIMEOUT=600
ANALYSIS_PROFILE=platform-v1
# code-v1 and mvp-v1 route runs to analysis-code; only a dedicated trusted host runs worker-code.
CODE_RUNTIME_ENABLED=false
CODE_RUNTIME_IMAGE=sourcehealth-sast
CODE_RUNTIME_TIMEOUT=180
PLATFORM_CACHE_TTL=300
CODE_CACHE_TTL=604800
RESULT_CACHE_TTL=300
REFRESH_INTERVAL=86400
# User SourceCraft connections only: independent base64 key containing 32 random bytes.
SOURCECRAFT_CREDENTIAL_KEY=
SOURCECRAFT_CONNECTION_TTL=1800
