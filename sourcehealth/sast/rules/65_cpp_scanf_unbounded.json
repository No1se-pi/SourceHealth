{
  "id": "CPP-SCANF-UNBOUNDED",
  "engine": "code_regex",
  "language": "cpp",
  "pattern": "\\b(?:scanf\\s{0,128}\\(\\s{0,128}|(?:fscanf|sscanf)\\s{0,128}\\([^,;\\n]{1,128},\\s{0,128})\"(?:\\\\[^\\n]|[^\"\\\\%\\n]|%%|%\\*?[0-9]{0,8}[hlLjzt]{0,2}[diouxXfFeEgGaAcpn]|%\\*?[0-9]{1,8}s){0,512}%(?:s|\\[)",
