  ],
  "message": "Создаётся RSA-ключ короче 2048 бит.",
  "recommendation": "Используйте RSA минимум 2048 бит или подходящий современный алгоритм.",
  "cwe": "CWE-326",
  "category": "crypto",
  "severity": "medium",
  "confidence": "medium",
  "references": [
    "https://pkg.go.dev/crypto/rsa"
  ]
}
