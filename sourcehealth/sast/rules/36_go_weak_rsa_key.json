{
  "id": "GO-WEAK-RSA-KEY",
  "engine": "code_regex",
  "language": "go",
  "pattern": "\\brsa\\s{0,128}\\.\\s{0,128}GenerateKey\\s{0,128}\\([^,;\\n]{1,128},\\s{0,128}(?:512|768|1024|1536)\\s{0,128}\\)",
  "keywords": [
    "generatekey"
  ],
  "suffixes": [
