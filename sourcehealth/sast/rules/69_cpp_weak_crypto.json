  "suffixes": [
    ".c",
    ".h",
    ".cc",
    ".hh",
    ".cpp",
    ".hpp",
    ".cxx",
    ".hxx",
    ".ipp",
    ".tpp"
  ],
  "message": "Используется устаревший криптографический примитив MD5/SHA-1/DES.",
  "recommendation": "Для защиты целостности используйте SHA-256/512, для шифрования — аутентифицированный современный алгоритм.",
  "cwe": "CWE-327",
  "category": "crypto",
  "severity": "medium",
  "confidence": "medium",
  "references": [
    "https://docs.openssl.org/master/man3/EVP_DigestInit/"
  ]
}
