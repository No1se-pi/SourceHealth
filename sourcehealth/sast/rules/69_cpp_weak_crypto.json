{
  "id": "CPP-WEAK-CRYPTO",
  "engine": "code_regex",
  "language": "cpp",
  "pattern": "\\b(?:MD5(?:_Init|_Update|_Final)?|SHA1(?:_Init|_Update|_Final)?|DES_set_key(?:_checked|_unchecked)?|EVP_(?:md5|sha1|des_cbc|des_ecb))\\s{0,128}\\(",
  "keywords": [
    "md5",
    "sha1",
    "des_"
