{
  "id": "GO-TLS-LEGACY-VERSION",
  "engine": "code_regex",
  "language": "go",
  "pattern": "\\bMinVersion\\s{0,128}[:=]\\s{0,128}tls\\s{0,128}\\.\\s{0,128}Version(?:SSL30|TLS10|TLS11)\\b",
  "keywords": [
    "minversion"
  ],
  "suffixes": [
    ".go"
  ],
  "message": "Разрешена устаревшая минимальная версия TLS.",
  "recommendation": "Установите минимум TLS 1.2, предпочтительно TLS 1.3.",
  "cwe": "CWE-327",
  "category": "crypto",
  "severity": "medium",
  "confidence": "medium",
  "references": [
    "https://pkg.go.dev/crypto/tls#Config"
  ]
}
