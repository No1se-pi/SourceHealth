# Copy to /etc/sourcehealth/sourcehealth.env on the host. Never commit the populated file.
#
# Secret generation commands (use independent random values for each secret):
# POSTGRES_PASSWORD:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SOURCECRAFT_CREDENTIAL_KEY (independent 32-byte key, base64 url-safe):
#   python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"

POSTGRES_PASSWORD=<random-hex-password>
DATABASE_URL=postgresql+psycopg://sourcehealth:<same-value-as-line-11>@127.0.0.1:15432/sourcehealth
REDIS_URL=redis://127.0.0.1:6379/0
SOURCECRAFT_API_BASE_URL=https://api.sourcecraft.tech
PUBLIC_ORIGIN=https://sourcehealth.tech
YANDEX_CLIENT_ID=<production-client-id>
YANDEX_CLIENT_SECRET=<production-client-secret>
YANDEX_REDIRECT_URI=https://sourcehealth.tech/api/v1/auth/yandex/callback
COOKIE_SECURE=true
SESSION_SECRET=<random-at-least-32-characters>
SOURCECRAFT_CREDENTIAL_KEY=<base64-of-independent-32-random-bytes>
SOURCECRAFT_CONNECTION_TTL=1800
ANALYSIS_TIMEOUT=1800
ANALYSIS_PROFILE=mvp-v1
CODE_RUNTIME_ENABLED=false
CODE_RUNTIME_IMAGE=sourcehealth-sast
CODE_RUNTIME_TIMEOUT=600
